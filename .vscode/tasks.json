{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gcc: 编译当前文件",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/gcc.ps1",
                "-Source", "${file}",
                "-Output", "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "options": { "cwd": "${workspaceFolder}" }
        },
        {
            "label": "gcc: 生成汇编",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/gcc.ps1",
                "-Source", "${file}",
                "-Output", "${workspaceFolder}/bin/${fileBasenameNoExtension}.s",
                "-Asm"
            ],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" }
        },
        {
            "label": "gcc: 编译并运行",
            "type": "shell",
            "command": "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe",
            "dependsOn": "gcc: 编译当前文件",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" }
        }
    ]
}
